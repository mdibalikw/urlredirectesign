              "script": {
                "exec": [
                  "const { Header } = require('postman-collection');",
                  "const cryptoJS = require('crypto-js');",
                  "",
                  "// === CONFIG ===",
                  "const hmacUsername = \"xx\";",
                  "const hmacSecret = \"xx\";",
                  "",
                  "// === GET URL + METHOD ===",
                  "const method = pm.request.method.toUpperCase();",
                  "const fullUrl = pm.variables.replaceIn(pm.request.url.toString());",
                  "",
                  "// Ensure the URL is parsed correctly",
                  "const parsedUrl = new URL(fullUrl);",
                  "const requestPath = parsedUrl.pathname + parsedUrl.search;",
                  "",
                  "// === BUILD REQUEST LINE ===",
                  "const requestLine = `${method} ${requestPath} HTTP/1.1`;",
                  "",
                  "// === DATE ===",
                  "const dateString = new Date().toUTCString();",
                  "",
                  "// === SIGNATURE ===",
                  "const stringToSign = `date: ${dateString}\\n${requestLine}`;",
                  "const digest = cryptoJS.HmacSHA256(stringToSign, hmacSecret);",
                  "const signature = cryptoJS.enc.Base64.stringify(digest);",
                  "",
                  "// === AUTH HEADER ===",
                  "const hmacHeader = `hmac username=\"${hmacUsername}\", algorithm=\"hmac-sha256\", headers=\"date request-line\", signature=\"${signature}\"`;",
                  "",
                  "// === ADD HEADERS ===",
                  "pm.request.headers.add(new Header({ key: \"Authorization\", value: hmacHeader }));",
                  "pm.request.headers.add(new Header({ key: \"Date\", value: dateString }));",
                  "",
                  "// === DEBUG LOGS (Optional) ===",
                  "console.log(\"Full URL:\", fullUrl);",
                  "console.log(\"Request Path:\", requestPath);",
                  "console.log(\"Request Line:\", requestLine);",
                  "console.log(\"String to Sign:\\n\", stringToSign);",
                  "console.log(\"Signature:\", signature);",
                  "console.log(\"Authorization Header:\", hmacHeader);",
                  "console.log(\"Date:\", dateString);",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
