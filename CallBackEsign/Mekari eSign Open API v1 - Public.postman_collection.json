          "item": [
            {
              "name": "Global - Request Sign",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const res = pm.response.json()",
                      "    pm.environment.set(\"envelope_id\", res.data.id)",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "hmac username=\"uJ2THlsRFtdOLlLV\", algorithm=\"hmac-sha256\", headers=\"date request-line\", signature=\"iN/U13qWPM27s/zF5TMNLraJcYdR/08wlU5Glqf8Gms=\"",
                    "description": "Sample value for OAuth2 auth:\n\nBearer CH1VOeeJqBf6CMR1mPVlFnlQhJD0Cx0W\n\nSample value for HMAC auth:\n\nhmac username=\"EqzkfkVHVJHopJZC\", algorithm=\"hmac-sha256\", headers=\"date request-line\", signature=\"oQP8eCu1JzTL7Nw8KRDtJeDtuvCQxMUTXJO28SfekdE=\"",
                    "disabled": true
                  },
                  {
                    "key": "Date",
                    "value": "Wed, 17 Jun 2026 07:38:43 GMT",
                    "description": "Current datetime in UTC timezone, as specified in RFC7231. Only needed for HMAC auth\n\nSample value :\nSun, 06 Nov 1994 08:49:37 GMT\n",
                    "disabled": true
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text",
