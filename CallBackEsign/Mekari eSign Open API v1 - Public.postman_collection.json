      "name": "Auth (OAuth2)",
      "item": [
        {
          "name": "Get Authorized Code (Open via Browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sso_auth_base_url}}/auth?client_id={{client_id}}&response_type=code&scope=esign&lang=id",
              "host": [
                "{{sso_auth_base_url}}"
              ],
              "path": [
                "auth"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "description": "Your application client id"
                },
                {
                  "key": "response_type",
                  "value": "code",
                  "description": "Mandatory and must be 'code'"
                },
                {
                  "key": "scope",
                  "value": "esign",
                  "description": "Mandatory and must be 'esign'"
                },
                {
                  "key": "lang",
                  "value": "id",
                  "description": "Language en or id"
                }
              ]
            },
            "description": "To obtain the authorized code, login to SSO and open the url via the browser needed."
          },
          "response": []
        },
